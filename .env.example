# URL de l'API Gateway (utilisée lorsque VITE_USE_MOCKS=false)
VITE_API_BASE_URL=http://localhost:8080/api
# true = toutes les requêtes sont servies par les données fictives typées
VITE_USE_MOCKS=true
# Domaine d'adresse e-mail accepté (ex. gmail.com pour tester). Par défaut : smartcampus.tn
# VITE_EMAIL_DOMAIN=smartcampus.tn

# Routes servies par un vrai back-end quand VITE_USE_MOCKS=false (les autres restent en données fictives)
# VITE_REAL_API_PREFIXES=/auth,/users,/roles,/login-history
