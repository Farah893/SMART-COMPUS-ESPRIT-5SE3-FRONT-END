# --- Dépendances et sorties de build (se régénèrent avec npm install / npm run build)
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
.vite/
.cache/
.eslintcache

# --- Configuration locale : chacun a la sienne (le modèle est .env.example)
.env
.env.*
!.env.example

# --- Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Éditeurs et outils personnels
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.cursor/

# --- Fichiers système (Windows, macOS, OneDrive)
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Fichiers temporaires
*.tmp
*.temp
*.bak
*.local
